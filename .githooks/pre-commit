#!/bin/bash
echo "Running unit tests before commit..."
cd "$(git rev-parse --show-toplevel)"
.venv/bin/pytest tests/unit/ -q --tb=line 2>&1
exit_code=$?
if [ $exit_code -ne 0 ]; then
    echo ""
    echo "COMMIT BLOCKED: unit tests failed. Fix them before committing."
    exit 1
fi
echo "Unit tests passed."
